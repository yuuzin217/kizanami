---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import StoryCard from '../components/StoryCard.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { newsArticles } from '../data/news';
import {
  getLatestArticlesByCategory,
  getArchiveDays,
  getEditionNumber,
  estimateReadingMinutes,
  formatJstDate,
  categoryLabels,
} from '../data/newsModel';
const latestByCategory = getLatestArticlesByCategory(newsArticles, 3);
const displayedArticles = latestByCategory.flatMap((group) => group.articles);
const latestDate = getArchiveDays(newsArticles)[0];
const hasSamples = displayedArticles.some((story) => story.isSample);
const editionNumber = getEditionNumber(newsArticles);
const categoryCount = latestByCategory.length;
const readingMinutes = estimateReadingMinutes(displayedArticles);
const base = import.meta.env.BASE_URL;
let storyNumber = 0;
---
<BaseLayout>
  <div class="wrap">
    <SiteHeader />
    <main id="main">
      <Hero storyCount={displayedArticles.length} editionNumber={editionNumber} categoryCount={categoryCount} readingMinutes={readingMinutes} />
      {hasSamples && <div class="disclaimer" role="note"><b>DESIGN PREVIEW</b><span>「SAMPLE」と表示された記事は架空のサンプルであり、実際の報道ではありません。</span></div>}
      <section id="news" aria-labelledby="stories-title">
        <div class="section-head">
          <div><div class="eyebrow">LATEST EDITION / FIVE CATEGORIES</div><h2 id="stories-title">最新のピックアップ</h2></div>
          <div class="subtitle">{latestDate ? `${formatJstDate(latestDate)}（JST）` : '記事準備中'}</div>
        </div>
        <div class="content-grid">
          <div class="stories">
            {displayedArticles.length === 0 && <p>現在、掲載できるニュースはありません。</p>}
            {latestByCategory.map((group) => (
              <section class="home-category-block" aria-labelledby={`cat-${group.category}`}>
                <h3 id={`cat-${group.category}`} class="home-category-head">
                  <a href={`${base}category/${group.category}/`}>{categoryLabels[group.category]}</a>
                </h3>
                {group.articles.map((story) => {
                  storyNumber += 1;
                  return <StoryCard story={story} number={storyNumber} />;
                })}
              </section>
            ))}
            <a class="archive-link" href={`${base}archive/`}>過去の記事を読む <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>