---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import StoryCard from '../components/StoryCard.astro';
import EditorialSidebar from '../components/EditorialSidebar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { newsArticles } from '../data/news';
import { getLatestArticles, getArchiveDays, getEditionNumber, getActiveCategoryCount, estimateReadingMinutes, formatJstDate } from '../data/newsModel';
const latest = getLatestArticles(newsArticles);
const latestDate = getArchiveDays(newsArticles)[0];
const hasSamples = latest.some((story) => story.isSample);
const editionNumber = getEditionNumber(newsArticles);
const categoryCount = getActiveCategoryCount(newsArticles);
const readingMinutes = estimateReadingMinutes(latest);
const year = latestDate ? latestDate.split('-')[0] : '';
---
<BaseLayout>
  <div class="wrap">
    <SiteHeader />
    <main id="main">
      <Hero storyCount={latest.length} editionNumber={editionNumber} categoryCount={categoryCount} readingMinutes={readingMinutes} />
      {hasSamples && <div class="disclaimer" role="note"><b>DESIGN PREVIEW</b><span>「SAMPLE」と表示された記事は架空のサンプルであり、実際の報道ではありません。</span></div>}
      <section id="news" aria-labelledby="stories-title">
        <div class="section-head">
          <div><div class="eyebrow">LATEST EDITION / AI NEWS</div><h2 id="stories-title">最新のピックアップ</h2></div>
          <div class="subtitle">{latestDate ? `${formatJstDate(latestDate)}（JST）` : '記事準備中'}</div>
        </div>
        <div class="content-grid">
          <div class="stories">
            {latest.length === 0 && <p>現在、掲載できるニュースはありません。</p>}
            {latest.map((story, index) => <StoryCard story={story} number={index + 1} />)}
            <a class="archive-link" href={`${import.meta.env.BASE_URL}archive/`}>過去の記事を読む <span aria-hidden="true">↗</span></a>
          </div>
          <EditorialSidebar editionNumber={editionNumber} storyCount={latest.length} year={year} />
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
