---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import StoryCard from '../../components/StoryCard.astro';
import { newsArticles } from '../../data/news';
import { getArchiveDays, getArticlesForDate, formatJstDate } from '../../data/newsModel';
export const getStaticPaths = (() => getArchiveDays(newsArticles).map((date) => ({
  params: { date }, props: { date },
}))) satisfies GetStaticPaths;
interface Props { date: string }
const { date } = Astro.props;
const articles = getArticlesForDate(newsArticles, date);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${formatJstDate(date)}の記事 | KIZANAMI`} description={`${formatJstDate(date)}のニュース一覧。`}>
  <div class="wrap">
    <SiteHeader />
    <main id="main" class="archive-page">
      <nav aria-label="パンくずリスト" class="breadcrumbs"><a href={base}>トップ</a><span aria-hidden="true">/</span><a href={`${base}archive/`}>過去の記事</a><span aria-hidden="true">/</span><span aria-current="page">{formatJstDate(date)}</span></nav>
      <div class="eyebrow">DAILY EDITION / JST</div>
      <h1>{formatJstDate(date)}</h1>
      <p class="archive-intro">この日のピックアップ：{articles.length}件。</p>
      <div class="archive-stories">{articles.map((story, index) => <StoryCard story={story} number={index + 1} />)}</div>
      <div class="article-bottom"><a href={`${base}archive/`}>すべての過去記事へ戻る</a></div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
