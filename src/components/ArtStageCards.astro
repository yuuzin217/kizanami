---
import { categoryLabels, type NewsCategory } from '../data/newsModel';

export interface ArtStageCard {
  category: NewsCategory;
  title: string;
  slug: string;
}

interface Props {
  cards: ArtStageCard[];
}

const { cards } = Astro.props;
const base = import.meta.env.BASE_URL;
---

{
  cards.length > 0 && (
    <div
      class="art-fan"
      role="group"
      aria-label="今日の注目記事（カテゴリ別ピックアップ）"
      data-front="0"
    >
      {cards.map((card, index) => {
        const articleUrl = `${base}news/${card.slug}/`;
        const categoryUrl = `${base}category/${card.category}/`;
        const isFront = index === 0;
        const href = isFront ? articleUrl : categoryUrl;
        const categoryKey = card.category.toUpperCase();
        const categoryLabel = categoryLabels[card.category];
        const ariaLabel = isFront
          ? `${card.title}（記事詳細）`
          : `${categoryLabel}カテゴリの記事一覧`;
        return (
          <a
            class:list={[
              'fan-card',
              `fan-pose-${cards.length}-${index}`,
              { 'is-front': isFront },
            ]}
            style={`z-index:${10 - index}`}
            href={href}
            aria-label={ariaLabel}
            data-article-url={articleUrl}
            data-category-url={categoryUrl}
            data-category-label={categoryLabel}
          >
            <span class="fan-card-dot" aria-hidden="true" />
            <span class="fan-card-cat">
              CATEGORY / {categoryKey}
            </span>
            <span class="fan-card-title">{card.title}</span>
          </a>
        );
      })}
      {cards.length >= 2 && (
        <div class="fan-nav">
          <button
            type="button"
            class="fan-nav-btn fan-nav-prev"
            aria-label="前のカード"
          >
            ‹
          </button>
          <button
            type="button"
            class="fan-nav-btn fan-nav-next"
            aria-label="次のカード"
          >
            ›
          </button>
        </div>
      )}
      <div class="fan-caption">FIG. 01 / TODAY IN FIVE CARDS</div>
    </div>
  )
}

<script>
  const ROTATE_MS = 4500;
  const TAP_PX = 8;
  const LOCK_PX = 10;
  const ROTATE_DEG_PER_PX = 0.12;
  const ROTATE_DEG_MAX = 12;
  const EXIT_MS = 280;
  const INSERT_SLIDE_MS = 250;
  const PULL_OUT_MS = 200;
  const PULL_LAND_MS = 250;
  const SWIPE_WIDTH_RATIO = 0.28;
  const SWIPE_MIN_PX = 64;

  interface FanRoot extends HTMLElement {
    __fanRestart?: () => void;
  }

  function clamp(value: number, min: number, max: number) {
    return Math.min(max, Math.max(min, value));
  }

  function setupFan(root: FanRoot) {
    const cards = Array.from(
      root.querySelectorAll<HTMLAnchorElement>('.fan-card'),
    );
    if (cards.length < 2) return;

    // Re-entry (e.g. astro:page-load): reuse the single closure created on
    // first setup so pause flags, listeners and the timer never split.
    if (root.__fanRestart) {
      root.__fanRestart();
      return;
    }

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    const prevBtn = root.querySelector<HTMLButtonElement>('.fan-nav-prev');
    const nextBtn = root.querySelector<HTMLButtonElement>('.fan-nav-next');

    let frontIndex = Number(root.dataset.front) || 0;
    if (frontIndex < 0 || frontIndex >= cards.length) frontIndex = 0;

    let intervalId: number | undefined;
    let hoverPause = false;
    let focusPause = false;
    let touchPause = false;
    let hiddenPause = document.hidden;
    let dragPause = false;
    let animating = false;
    let inserting = false;
    let finalizeInsert: (() => void) | null = null;

    let activeCard: HTMLAnchorElement | null = null;
    let activePointerId: number | null = null;
    let opGeneration = 0;
    let startX = 0;
    let startY = 0;
    let dragMoved = false;
    let suppressClick = false;

    const clearDragVisual = (card: HTMLAnchorElement) => {
      card.classList.remove(
        'is-dragging',
        'is-exiting',
        'is-snap-back',
        'is-offset',
        'is-sliding',
        'is-landing-text',
      );
      card.style.removeProperty('--dx');
      card.style.removeProperty('--dy');
      card.style.removeProperty('--dr');
      card.style.removeProperty('--ix');
      card.style.removeProperty('--iy');
      card.style.removeProperty('--ir');
      card.style.removeProperty('--slide-ms');
      card.style.removeProperty('opacity');
    };

    const clearAllDragVisuals = () => {
      cards.forEach((card) => clearDragVisual(card));
    };

    const setDragVars = (
      card: HTMLAnchorElement,
      dx: number,
      dy: number,
      dr: number,
    ) => {
      card.style.setProperty('--dx', `${dx}px`);
      card.style.setProperty('--dy', `${dy}px`);
      card.style.setProperty('--dr', `${dr}deg`);
    };

    const swipeThreshold = (card: HTMLAnchorElement) =>
      Math.max(card.getBoundingClientRect().width * SWIPE_WIDTH_RATIO, SWIPE_MIN_PX);

    const applyFront = (index: number) => {
      frontIndex = index;
      root.dataset.front = String(index);
      const n = cards.length;
      cards.forEach((card, i) => {
        clearDragVisual(card);
        const dist = (i - index + n) % n;
        card.style.zIndex = String(10 - dist);
        const isFront = i === index;
        card.classList.toggle('is-front', isFront);
        const articleUrl = card.dataset.articleUrl ?? card.href;
        const categoryUrl = card.dataset.categoryUrl ?? card.href;
        card.href = isFront ? articleUrl : categoryUrl;
        const title =
          card.querySelector('.fan-card-title')?.textContent ?? '';
        card.setAttribute(
          'aria-label',
          isFront
            ? `${title}（記事詳細）`
            : `${card.dataset.categoryLabel ?? ''}カテゴリの記事一覧`,
        );
        if (window.matchMedia('(max-width: 900px)').matches) {
          card.tabIndex = isFront ? 0 : -1;
        } else {
          card.removeAttribute('tabindex');
        }
      });
    };

    const shouldRun = () =>
      !hoverPause &&
      !focusPause &&
      !touchPause &&
      !hiddenPause &&
      !dragPause &&
      !animating &&
      !inserting &&
      !motionQuery.matches;

    const runFinalizeInsert = () => {
      if (finalizeInsert) {
        const fn = finalizeInsert;
        finalizeInsert = null;
        fn();
      }
    };

    const slideOffsetToPose = (
      card: HTMLAnchorElement,
      gen: number,
      onComplete: () => void,
    ) => {
      let done = false;
      const onDone = (event?: Event) => {
        if (
          event instanceof TransitionEvent &&
          (event.target !== card || event.propertyName !== 'transform')
        ) {
          return;
        }
        if (done) return;
        done = true;
        card.removeEventListener('transitionend', onDone);
        if (gen !== opGeneration) return;
        card.classList.remove('is-sliding');
        card.classList.remove('is-offset');
        card.style.removeProperty('--ix');
        card.style.removeProperty('--iy');
        card.style.removeProperty('--ir');
        card.style.removeProperty('--slide-ms');
        onComplete();
      };
      void card.offsetWidth;
      card.classList.add('is-sliding');
      card.classList.remove('is-offset');
      card.addEventListener('transitionend', onDone);
      const ms = Number.parseInt(
        card.style.getPropertyValue('--slide-ms') || String(INSERT_SLIDE_MS),
        10,
      );
      window.setTimeout(onDone, ms + 80);
    };

    const slidePoseToOffset = (
      card: HTMLAnchorElement,
      gen: number,
      ix: number,
      iy: number,
      ir: number,
      slideMs: number,
      onComplete: () => void,
    ) => {
      let done = false;
      const onDone = (event?: Event) => {
        if (
          event instanceof TransitionEvent &&
          (event.target !== card || event.propertyName !== 'transform')
        ) {
          return;
        }
        if (done) return;
        done = true;
        card.removeEventListener('transitionend', onDone);
        if (gen !== opGeneration) return;
        card.classList.remove('is-sliding');
        onComplete();
      };
      card.classList.add('is-sliding');
      card.style.setProperty('--slide-ms', `${slideMs}ms`);
      card.style.setProperty('--ix', `${ix}px`);
      card.style.setProperty('--iy', `${iy}px`);
      card.style.setProperty('--ir', `${ir}deg`);
      card.classList.add('is-offset');
      card.addEventListener('transitionend', onDone);
      window.setTimeout(onDone, slideMs + 80);
    };

    const clearTimer = () => {
      if (intervalId !== undefined) {
        window.clearInterval(intervalId);
        intervalId = undefined;
      }
    };

    const startTimer = () => {
      clearTimer();
      if (!shouldRun()) return;
      intervalId = window.setInterval(() => {
        if (!shouldRun()) return;
        peelTo((frontIndex + 1) % cards.length);
      }, ROTATE_MS);
    };

    const syncTimer = () => {
      if (shouldRun()) startTimer();
      else clearTimer();
    };

    const endDragPause = () => {
      dragPause = false;
      activeCard = null;
      activePointerId = null;
      syncTimer();
    };

    const advanceFront = (delta: number) => {
      const target = (frontIndex + delta + cards.length) % cards.length;
      if (delta < 0) {
        pullTo(target);
      } else {
        peelTo(target);
      }
    };

    const pullTo = (targetIndex: number) => {
      runFinalizeInsert();
      if (animating) return;
      if (targetIndex === frontIndex) return;

      // Start a new generation so a finalized insert's leftover slide
      // completion (transitionend / fallback timeout) can never fire into
      // this operation — the pull target may be that very card.
      opGeneration++;

      const afterPull = () => {
        syncTimer();
      };

      if (motionQuery.matches) {
        applyFront(targetIndex);
        afterPull();
        return;
      }

      animating = true;
      syncTimer();

      const card = cards[targetIndex];
      const gen = opGeneration;
      const pullIx = Math.max(120, card.offsetWidth * 0.5);
      const pullIr = 6;

      slidePoseToOffset(card, gen, pullIx, 0, pullIr, PULL_OUT_MS, () => {
        if (gen !== opGeneration) return;

        applyFront(targetIndex);
        card.style.setProperty('--ix', `${pullIx}px`);
        card.style.setProperty('--iy', '0px');
        card.style.setProperty('--ir', `${pullIr}deg`);
        card.style.setProperty('--slide-ms', `${PULL_LAND_MS}ms`);
        card.classList.add('is-offset', 'is-landing-text');

        slideOffsetToPose(card, gen, () => {
          if (gen !== opGeneration) return;
          card.classList.remove('is-landing-text');
          animating = false;
          afterPull();
        });
      });
    };

    const peelTo = (
      targetIndex: number,
      options: {
        exitDx?: number;
        exitDy?: number;
        exitDr?: number;
        fromDrag?: boolean;
      } = {},
    ) => {
      runFinalizeInsert();
      if (animating) return;
      if (targetIndex === frontIndex) return;

      // Same generation guard as pullTo: invalidate leftover completions
      // from a finalized insert before starting this peel.
      opGeneration++;

      const afterPeel = () => {
        if (options.fromDrag) {
          endDragPause();
        } else {
          syncTimer();
        }
      };

      if (motionQuery.matches) {
        applyFront(targetIndex);
        afterPeel();
        return;
      }

      animating = true;
      if (!options.fromDrag) {
        syncTimer();
      }

      const exitCard = cards[frontIndex];
      const gen = opGeneration;
      let exitDone = false;

      const finishPeel = () => {
        if (exitDone) return;
        exitDone = true;
        exitCard.removeEventListener('transitionend', onExit);
        if (gen !== opGeneration) return;

        const returnedCard = exitCard;
        clearDragVisual(returnedCard);
        applyFront(targetIndex);

        const exitSign = exitX >= 0 ? 1 : -1;
        const insertIx = -exitSign * Math.max(120, returnedCard.offsetWidth * 0.5);
        const insertIr = -exitSign * 6;

        returnedCard.style.setProperty('--ix', `${insertIx}px`);
        returnedCard.style.setProperty('--iy', '0px');
        returnedCard.style.setProperty('--ir', `${insertIr}deg`);
        returnedCard.style.setProperty('--slide-ms', `${INSERT_SLIDE_MS}ms`);
        returnedCard.classList.add('is-offset');

        inserting = true;

        let insertDone = false;
        const finishInsert = () => {
          if (insertDone) return;
          insertDone = true;
          inserting = false;
          finalizeInsert = null;
          animating = false;
          afterPeel();
        };

        finalizeInsert = () => {
          if (gen !== opGeneration) return;
          clearDragVisual(returnedCard);
          finishInsert();
        };

        slideOffsetToPose(returnedCard, gen, () => {
          if (gen !== opGeneration) return;
          finishInsert();
        });
      };

      const onExit = (event: Event) => {
        if (
          event instanceof TransitionEvent &&
          event.propertyName !== 'transform'
        ) {
          return;
        }
        finishPeel();
      };

      let exitX: number;
      let exitY: number;
      let exitDr: number;

      if (
        options.exitDx !== undefined &&
        options.exitDy !== undefined &&
        options.exitDr !== undefined
      ) {
        exitX = options.exitDx;
        exitY = options.exitDy;
        exitDr = options.exitDr;
      } else {
        const sign = -1;
        exitX = sign * Math.max(window.innerWidth * 0.55, swipeThreshold(exitCard) * 2);
        exitY = exitX * 0.12;
        exitDr = sign * 8;
      }

      exitCard.classList.remove('is-dragging');
      exitCard.classList.add('is-exiting');
      setDragVars(exitCard, exitX, exitY, exitDr);
      exitCard.addEventListener('transitionend', onExit);
      window.setTimeout(finishPeel, EXIT_MS + 80);
    };

    const finishSnapBack = (card: HTMLAnchorElement) => {
      if (motionQuery.matches) {
        clearDragVisual(card);
        endDragPause();
        return;
      }
      animating = true;
      const gen = opGeneration;
      let done = false;
      const onDone = () => {
        if (done) return;
        done = true;
        card.removeEventListener('transitionend', onDone);
        if (gen !== opGeneration) return;
        animating = false;
        clearDragVisual(card);
        endDragPause();
      };
      card.classList.remove('is-dragging');
      card.classList.add('is-snap-back');
      setDragVars(card, 0, 0, 0);
      card.addEventListener('transitionend', onDone);
      window.setTimeout(onDone, 560);
    };

    const abortDrag = (card: HTMLAnchorElement, pointerId: number) => {
      if (dragMoved) suppressClick = true;
      try {
        if (card.hasPointerCapture(pointerId)) {
          card.releasePointerCapture(pointerId);
        }
      } catch {
        /* already released */
      }
      clearDragVisual(card);
      endDragPause();
    };

    const commitSwipe = (card: HTMLAnchorElement, dx: number, pointerId: number) => {
      const sign = dx >= 0 ? 1 : -1;
      const exitX = sign * Math.max(window.innerWidth * 0.55, swipeThreshold(card) * 2);
      const exitDr = clamp(dx * ROTATE_DEG_PER_PX, -ROTATE_DEG_MAX, ROTATE_DEG_MAX) + sign * 8;

      try {
        if (card.hasPointerCapture(pointerId)) {
          card.releasePointerCapture(pointerId);
        }
      } catch {
        /* already released */
      }

      dragPause = true;
      syncTimer();

      peelTo((frontIndex + 1) % cards.length, {
        exitDx: exitX,
        exitDy: exitX * 0.12,
        exitDr,
        fromDrag: true,
      });
    };

    const onPointerDown = (event: PointerEvent) => {
      runFinalizeInsert();
      if (animating) return;
      if (activeCard) return;
      if (event.button !== 0) return;
      suppressClick = false;
      const target = event.target;
      if (!(target instanceof Element)) return;
      const card = target.closest<HTMLAnchorElement>('.fan-card');
      if (!card || !root.contains(card) || !card.classList.contains('is-front')) {
        return;
      }

      opGeneration++;
      activeCard = card;
      activePointerId = event.pointerId;
      startX = event.clientX;
      startY = event.clientY;
      dragMoved = false;

      dragPause = true;
      syncTimer();

      card.classList.add('is-dragging');
      setDragVars(card, 0, 0, 0);
      try {
        card.setPointerCapture(event.pointerId);
      } catch {
        clearDragVisual(card);
        endDragPause();
      }
    };

    const onPointerMove = (event: PointerEvent) => {
      if (!activeCard || event.pointerId !== activePointerId) return;

      const dx = event.clientX - startX;
      const dy = event.clientY - startY;

      if (Math.hypot(dx, dy) >= TAP_PX) {
        dragMoved = true;
      }

      if (
        Math.abs(dy) > LOCK_PX &&
        Math.abs(dy) > Math.abs(dx)
      ) {
        abortDrag(activeCard, event.pointerId);
        return;
      }

      const visualDy = dy * 0.3;
      const dr = clamp(dx * ROTATE_DEG_PER_PX, -ROTATE_DEG_MAX, ROTATE_DEG_MAX);
      setDragVars(activeCard, dx, visualDy, dr);
    };

    const onPointerUp = (event: PointerEvent) => {
      if (!activeCard || event.pointerId !== activePointerId) return;

      const card = activeCard;
      const pointerId = event.pointerId;
      const dx = event.clientX - startX;
      const dy = event.clientY - startY;
      const distance = Math.hypot(dx, dy);

      if (distance >= TAP_PX) {
        dragMoved = true;
      }

      if (Math.abs(dy) > LOCK_PX && Math.abs(dy) > Math.abs(dx)) {
        abortDrag(card, pointerId);
        return;
      }

      if (dragMoved) {
        suppressClick = true;
      }

      if (distance < TAP_PX) {
        try {
          if (card.hasPointerCapture(pointerId)) {
            card.releasePointerCapture(pointerId);
          }
        } catch {
          /* already released */
        }
        clearDragVisual(card);
        endDragPause();
        return;
      }

      const threshold = swipeThreshold(card);
      if (Math.abs(dx) >= threshold) {
        commitSwipe(card, dx, pointerId);
        return;
      }

      try {
        if (card.hasPointerCapture(pointerId)) {
          card.releasePointerCapture(pointerId);
        }
      } catch {
        /* already released */
      }
      finishSnapBack(card);
    };

    const onPointerCancel = (event: PointerEvent) => {
      if (!activeCard || event.pointerId !== activePointerId) return;
      const card = activeCard;
      if (dragMoved) suppressClick = true;
      try {
        if (card.hasPointerCapture(event.pointerId)) {
          card.releasePointerCapture(event.pointerId);
        }
      } catch {
        /* already released */
      }
      clearDragVisual(card);
      endDragPause();
    };

    root.addEventListener('pointerdown', onPointerDown);
    root.addEventListener('pointermove', onPointerMove);
    root.addEventListener('pointerup', onPointerUp);
    root.addEventListener('pointercancel', onPointerCancel);

    root.addEventListener('dragstart', (event) => {
      event.preventDefault();
    });

    root.addEventListener(
      'click',
      (event) => {
        if (!suppressClick) return;
        event.preventDefault();
        event.stopPropagation();
        suppressClick = false;
      },
      true,
    );

    // A click generated from the keyboard has no preceding pointerdown to
    // clear a stale suppression flag; clear it on keydown instead.
    root.addEventListener('keydown', () => {
      suppressClick = false;
    });

    root.addEventListener('mouseenter', () => {
      hoverPause = true;
      syncTimer();
    });
    root.addEventListener('mouseleave', () => {
      hoverPause = false;
      syncTimer();
    });

    root.addEventListener('focusin', () => {
      focusPause = true;
      syncTimer();
    });
    root.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (next instanceof Node && root.contains(next)) return;
      focusPause = false;
      syncTimer();
    });

    const resumeTouch = () => {
      window.setTimeout(() => {
        touchPause = false;
        syncTimer();
      }, 400);
    };
    root.addEventListener(
      'touchstart',
      () => {
        touchPause = true;
        syncTimer();
      },
      { passive: true },
    );
    root.addEventListener('touchend', resumeTouch);
    root.addEventListener('touchcancel', resumeTouch);

    document.addEventListener('visibilitychange', () => {
      hiddenPause = document.hidden;
      syncTimer();
    });
    motionQuery.addEventListener('change', syncTimer);

    prevBtn?.addEventListener('click', () => advanceFront(-1));
    nextBtn?.addEventListener('click', () => advanceFront(1));

    const restart = () => {
      opGeneration++;
      finalizeInsert = null;
      inserting = false;
      clearAllDragVisuals();
      animating = false;
      dragPause = false;
      activeCard = null;
      activePointerId = null;
      dragMoved = false;
      suppressClick = false;
      applyFront(frontIndex);
      syncTimer();
    };
    root.__fanRestart = restart;
    restart();
  }

  function initArtFan() {
    document.querySelectorAll<FanRoot>('.art-fan').forEach(setupFan);
  }

  initArtFan();
  document.addEventListener('astro:page-load', initArtFan);
</script>