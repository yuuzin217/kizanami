---
import type { NewsArticle } from '../data/newsModel';
import { categoryLabels, formatPublicationDate } from '../data/newsModel';
interface Props { story: NewsArticle; number: number }
const { story, number } = Astro.props;
const href = `${import.meta.env.BASE_URL}news/${story.slug}/`;
---
<article class="story" aria-labelledby={`title-${story.id}`}>
  <div class="story-num" aria-hidden="true">{String(number).padStart(2, '0')}</div>
  <div class="story-body">
    <div class="story-cat">{categoryLabels[story.category]} / {story.isSample ? 'SAMPLE' : 'NEWS'}</div>
    <h3 id={`title-${story.id}`}><a class="story-title-link" href={href}>{story.title}</a></h3>
    <p>{story.summary}</p>
    <div class="story-meta">
      <time datetime={story.publishedAt}>{formatPublicationDate(story.publishedAt)}</time>
      <a href={href} aria-label={`${story.title} の記事詳細を読む`}>記事を読む <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>
