---
import ArtStageCards, {
  type ArtStageCard,
} from './ArtStageCards.astro';

interface Props {
  storyCount: number;
  editionNumber: number;
  categoryCount: number;
  readingMinutes: number;
  cards: ArtStageCard[];
}
const { storyCount, editionNumber, categoryCount, readingMinutes, cards } =
  Astro.props;
const padded = String(editionNumber).padStart(3, '0');
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <div class="eyebrow edition-label"><span class="dot" aria-hidden="true">●</span> THE DAILY EDITION <span class="divider" aria-hidden="true"></span> ISSUE NO. {padded}</div>
    <h1 id="hero-title">世界は今日も、<br /><em>静かに動く。</em></h1>
    <p class="lead">大切なのは、情報の量ではなく、何を知るか。<br />今日の動きを、少し深く、少し丁寧に。<br />ニュースに、余白のある時間を。</p>
    <a class="hero-cta" href="#news">今日の{storyCount}本を読む <span aria-hidden="true">↗</span></a>
    <div class="stats" aria-label="掲載情報">
      <div class="stat"><strong>{String(storyCount).padStart(2, '0')}</strong><small>TODAY'S STORIES</small></div>
      <div class="stat"><strong>{String(categoryCount).padStart(2, '0')}</strong><small>ACTIVE CATEGORY</small></div>
      <div class="stat"><strong>{`${readingMinutes}′`}</strong><small>TO READ</small></div>
    </div>
  </div>
  <ArtStageCards cards={cards} />
</section>
