---
import '../styles/global.css';
import '../styles/news-pages.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KIZANAMI — 兆しを読む、世界を知る。',
  description = '世界の変化の兆しを、短く、少し深く。KIZANAMIのニュースポータル。',
} = Astro.props;
const favicon = `${import.meta.env.BASE_URL}favicon.svg`;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f1e8" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@400;500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <slot />
  </body>
</html>
